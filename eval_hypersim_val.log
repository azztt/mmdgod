# Base configuration for RGB-D domain-generalized 3D detection
# Inherits most settings from Base.yaml, only adds RGBD-specific config

_BASE_: "../Base.yaml"

# Override model to use RGBD architecture
MODEL:
  META_ARCHITECTURE: "RCNN3D_RGBD"
  
  # Override backbone - don't use DLA, use dual encoder ResNet
  BACKBONE:
    NAME: "build_dual_encoder_fpn_backbone"
  
  # Enable dual encoder for RGB and depth
  USE_DUAL_ENCODER: True
  
  # RGB encoder settings (fully frozen for domain-invariant features)
  RGB_RESNET_DEPTH: 50
  RGB_FROZEN: True
  RGB_FROZEN_STAGES: 4
  
  # Depth encoder settings (partially frozen)
  DEPTH_RESNET_DEPTH: 50
  DEPTH_FROZEN: False
  DEPTH_FROZEN_STAGES: 2
  
  # Fusion type: 'concat', 'add', 'gated'
  FUSION_TYPE: "concat"
  
  # Depth normalization
  DEPTH_PIXEL_MEAN: 0.0
  DEPTH_PIXEL_STD: 1.0
  
  # FPN expects ResNet feature names from dual encoder
  FPN:
    IN_FEATURES: ["res2", "res3", "res4", "res5"]
    OUT_CHANNELS: 256
    NORM: ""  # Empty = no norm
    FUSE_TYPE: "sum"
  
  # Anchor sizes for 5 FPN levels (p2-p6)
  ANCHOR_GENERATOR:
    SIZES: [[32], [64], [128], [256], [512]]
    ASPECT_RATIOS: [[0.5, 1.0, 2.0]]
  
  # RPN uses all FPN levels including p6
  RPN:
    IN_FEATURES: ["p2", "p3", "p4", "p5", "p6"]
  
  # ROI heads use p2-p5 (not p6)
  ROI_HEADS:
    IN_FEATURES: ["p2", "p3", "p4", "p5"]
    NUM_CLASSES: 31  # Match Hypersim categories

# Input settings - match Omni3D multi-scale training
INPUT:
  MIN_SIZE_TRAIN: (256, 288, 320, 352, 384, 416, 448, 480, 512)
  MIN_SIZE_TEST: 512
  MAX_SIZE_TEST: 512

# Solver settings matching Omni3D style but scaled for single dataset
# Using conservative LR for stability with dual encoder
SOLVER:
  IMS_PER_BATCH: 128  # 32 per GPU x 4 GPUs
  BASE_LR: 0.02       # Conservative LR - dual encoder needs lower LR
  STEPS: (12000, 16000)  # ~60% and ~80% of training
  MAX_ITER: 20000     # ~49 epochs
  WARMUP_ITERS: 1000  # Longer warmup for stability
  WARMUP_FACTOR: 0.001
  CHECKPOINT_PERIOD: 4000  # ~5 checkpoints total

TEST:
  EVAL_PERIOD: 4000   # Evaluate ~5 times during training

VIS_PERIOD: 2000

DATALOADER:
  NUM_WORKERS: 8  # 2 workers per GPU
  SAMPLER_TRAIN: "RepeatFactorTrainingSampler"
  REPEAT_THRESHOLD: 0.1

# Dataset Configuration
DATASETS:
  CATEGORY_NAMES: ('person', 'books', 'chair', 'towel', 'blinds', 'window', 'lamp', 'shelves', 'mirror', 'sink', 'cabinet', 'bathtub', 'door', 'toilet', 'desk', 'box', 'bookcase', 'picture', 'table', 'counter', 'bed', 'night stand', 'dresser', 'pillow', 'sofa', 'television', 'floor mat', 'curtain', 'clothes', 'stationery', 'refrigerator')
  DATA_ROOT: "/mnt/data/users/anweshan/omni3d/data"
  MANIFEST_ROOT: "/mnt/data/users/anweshan/omni3d/data/unidet3d_format/cleaned_manifests"
  TRAIN: ("hypersim_train_rgbd",)
  TRAIN_MANIFEST: "hypersim_train_filtered.json"  # Full training dataset (52k images)
  # TRAIN_MANIFEST: "hypersim_train_sampled.json"  # Sampled for debugging (500 images)
  # VAL: ("hypersim_val_rgbd",)
  TEST: ("sunrgbd_val_rgbd",)

OUTPUT_DIR: "./output/rgbd_base"

